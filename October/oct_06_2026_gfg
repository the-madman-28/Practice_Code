class Solution {
public:
    int n, m;
    
    int dfs(int i, int j, vector<vector<int>>& matrix,
            vector<vector<int>>& dp) {
        
        if (dp[i][j] != -1)
            return dp[i][j];

        int ans = 1;

        int dx[] = {-1, 1, 0, 0};
        int dy[] = {0, 0, -1, 1};

        for (int k = 0; k < 4; k++) {
            int ni = i + dx[k];
            int nj = j + dy[k];

            if (ni >= 0 && ni < n &&
                nj >= 0 && nj < m &&
                matrix[ni][nj] > matrix[i][j]) {
                
                ans = max(ans, 1 + dfs(ni, nj, matrix, dp));
            }
        }

        return dp[i][j] = ans;
    }

    int longIncPath(vector<vector<int>> &matrix, int n, int m) {
        this->n = n;
        this->m = m;

        vector<vector<int>> dp(n, vector<int>(m, -1));

        int answer = 0;

        for (int i = 0; i < n; i++) {
            for (int j = 0; j < m; j++) {
                answer = max(answer, dfs(i, j, matrix, dp));
            }
        }

        return answer;
    }
};
