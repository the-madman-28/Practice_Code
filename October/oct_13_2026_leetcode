class Solution {
public:
    long long maxAlternatingSum(vector<int>& nums) {
        int n = nums.size();

        vector<long long> sq(n);

        for (int i = 0; i < n; i++) {
            long long x = nums[i];
            sq[i] = x * x;
        }

        sort(sq.begin(), sq.end());

        long long ans = 0;

        // Largest values get '+' signs
        // Smallest values get '-' signs.
        int negative = n / 2;

        for (int i = 0; i < n; i++) {
            if (i < negative)
                ans -= sq[i];
            else
                ans += sq[i];
        }

        return ans;
    }
};
