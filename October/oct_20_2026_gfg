class Solution {
public:
    vector<int> lexicographicallyLargest(vector<int> &arr) {
        int n = arr.size();
        int i = 0;

        while (i < n) {
            int j = i;

            // Find the end of the same-parity group
            while (j < n && (arr[j] % 2) == (arr[i] % 2)) {
                j++;
            }

            // Sort this group in descending order
            sort(arr.begin() + i, arr.begin() + j, greater<int>());

            i = j;
        }

        return arr;
    }
};
