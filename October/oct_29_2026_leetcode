class Solution {
    struct Fenwick {
        int n;
        vector<int> bit;

        Fenwick(int n) : n(n), bit(n + 1, 0) {}

        void add(int idx, int val) {
            for (++idx; idx <= n; idx += idx & -idx)
                bit[idx] ^= val;
        }

        int query(int idx) {
            int res = 0;
            for (++idx; idx > 0; idx -= idx & -idx)
                res ^= bit[idx];
            return res;
        }

        // XOR val to every position in [l, r]
        void rangeXor(int l, int r, int val) {
            add(l, val);
            if (r + 1 < n)
                add(r + 1, val);
        }
    };

public:
    vector<bool> palindromePath(
        int n,
        vector<vector<int>>& edges,
        string s,
        vector<string>& queries
    ) {
        const int LOG = 20;

        vector<vector<int>> adj(n);

        for (auto &e : edges) {
            adj[e[0]].push_back(e[1]);
            adj[e[1]].push_back(e[0]);
        }

        // --------------------------------------------------
        // 1. Euler tour + parent + depth
        // --------------------------------------------------

        vector<int> parent(n, -1);
        vector<int> depth(n, 0);
        vector<int> tin(n), tout(n);
        vector<int> order;
        order.reserve(n);

        int timer = 0;

        // Iterative DFS to avoid recursion-depth issues
        vector<pair<int, int>> st;
        st.push_back({0, 0});
        parent[0] = 0;

        while (!st.empty()) {
            int u = st.back().first;
            int &idx = st.back().second;

            if (idx == 0) {
                tin[u] = timer++;
                order.push_back(u);
            }

            if (idx < (int)adj[u].size()) {
                int v = adj[u][idx++];

                if (v == parent[u])
                    continue;

                parent[v] = u;
                depth[v] = depth[u] + 1;
                st.push_back({v, 0});
            } else {
                tout[u] = timer - 1;
                st.pop_back();
            }
        }

        // --------------------------------------------------
        // 2. Binary lifting for LCA
        // --------------------------------------------------

        vector<vector<int>> up(LOG, vector<int>(n));

        for (int u = 0; u < n; u++)
            up[0][u] = parent[u];

        for (int j = 1; j < LOG; j++) {
            for (int u = 0; u < n; u++) {
                up[j][u] = up[j - 1][up[j - 1][u]];
            }
        }

        auto lca = [&](int a, int b) {
            if (depth[a] < depth[b])
                swap(a, b);

            int diff = depth[a] - depth[b];

            for (int j = 0; j < LOG; j++) {
                if (diff & (1 << j))
                    a = up[j][a];
            }

            if (a == b)
                return a;

            for (int j = LOG - 1; j >= 0; j--) {
                if (up[j][a] != up[j][b]) {
                    a = up[j][a];
                    b = up[j][b];
                }
            }

            return parent[a];
        };

        // --------------------------------------------------
        // 3. Initial root-to-node XOR masks
        // --------------------------------------------------

        vector<int> charMask(n);
        vector<int> pref(n);

        for (int u : order) {
            charMask[u] = 1 << (s[u] - 'a');

            if (u == 0)
                pref[u] = charMask[u];
            else
                pref[u] = pref[parent[u]] ^ charMask[u];
        }

        // Euler-order array of prefix masks
        vector<int> eulerValue(n);

        for (int u = 0; u < n; u++)
            eulerValue[tin[u]] = pref[u];

        // --------------------------------------------------
        // 4. Fenwick difference array
        // --------------------------------------------------

        Fenwick fw(n);

        // Build difference array:
        // diff[i] = value[i] XOR value[i-1]
        for (int i = 0; i < n; i++) {
            int diff = eulerValue[i];

            if (i > 0)
                diff ^= eulerValue[i - 1];

            fw.add(i, diff);
        }

        auto getPref = [&](int u) {
            return fw.query(tin[u]);
        };

        // --------------------------------------------------
        // 5. Process queries
        // --------------------------------------------------

        vector<bool> answer;

        for (string &q : queries) {
            stringstream ss(q);

            string type;
            int u;
            ss >> type >> u;

            if (type == "update") {
                char c;
                ss >> c;

                int oldMask = charMask[u];
                int newMask = 1 << (c - 'a');

                if (oldMask != newMask) {
                    int change = oldMask ^ newMask;

                    /*
                     * Changing u changes the root-to-node XOR
                     * for u and every descendant of u.
                     */
                    fw.rangeXor(tin[u], tout[u], change);

                    charMask[u] = newMask;
                }
            }
            else {
                int v;
                ss >> v;

                int w = lca(u, v);

                int pathMask =
                    getPref(u) ^
                    getPref(v) ^
                    charMask[w];

                // At most one character may have odd frequency.
                answer.push_back(
                    __builtin_popcount((unsigned)pathMask) <= 1
                );
            }
        }

        return answer;
    }
};
