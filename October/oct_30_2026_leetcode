class Solution {
public:
    int shortestPath(int n, vector<vector<int>>& edges, string labels, int k) {
        if (k == 0)
            return -1;

        vector<vector<pair<int, int>>> adj(n);

        for (auto &e : edges) {
            int u = e[0];
            int v = e[1];
            int w = e[2];

            adj[u].push_back({v, w});
        }

        const long long INF = 1e18;

        // dist[node][consecutive count]
        vector<vector<long long>> dist(n, vector<long long>(k + 1, INF));

        // {cost, node, consecutive_count}
        using State = tuple<long long, int, int>;

        priority_queue<State, vector<State>, greater<State>> pq;

        // Starting node contributes one character.
        dist[0][1] = 0;
        pq.push({0, 0, 1});

        while (!pq.empty()) {
            auto [cost, u, len] = pq.top();
            pq.pop();

            if (cost != dist[u][len])
                continue;

            if (u == n - 1)
                return (int)cost;

            for (auto &[v, w] : adj[u]) {
                int newLen;

                if (labels[u] == labels[v])
                    newLen = len + 1;
                else
                    newLen = 1;

                if (newLen > k)
                    continue;

                long long newCost = cost + w;

                if (newCost < dist[v][newLen]) {
                    dist[v][newLen] = newCost;
                    pq.push({newCost, v, newLen});
                }
            }
        }

        return -1;
    }
};
