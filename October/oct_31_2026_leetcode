class Solution {
public:
    static const int MOD = 1000000007;

    int uniquePaths(vector<vector<int>>& grid) {
        int m = grid.size();
        int n = grid[0].size();

        // dp[i][j] = number of ways to actually reach (i,j)
        // where (i,j) is not a mirror.
        vector<vector<long long>> dp(m, vector<long long>(n, 0));

        if (grid[0][0] == 1)
            return 0;

        dp[0][0] = 1;

        // Resolve what happens when we try to move from (i,j)
        // in direction dir:
        // dir = 0 -> right
        // dir = 1 -> down
        //
        // Returns the first non-mirror cell reached.
        auto move = [&](int i, int j, int dir) {
            while (true) {
                if (dir == 0)
                    j++;
                else
                    i++;

                // Moved outside the grid
                if (i >= m || j >= n)
                    return pair<int, int>{-1, -1};

                // Reached a normal cell
                if (grid[i][j] == 0)
                    return pair<int, int>{i, j};

                // We entered a mirror.
                //
                // If we entered from the left (moving right),
                // turn down.
                //
                // If we entered from above (moving down),
                // turn right.
                dir ^= 1;
            }
        };

        for (int i = 0; i < m; i++) {
            for (int j = 0; j < n; j++) {

                if (grid[i][j] == 1 || dp[i][j] == 0)
                    continue;

                // Already at destination
                if (i == m - 1 && j == n - 1)
                    continue;

                // Try moving right
                auto [r1, c1] = move(i, j, 0);

                if (r1 != -1) {
                    dp[r1][c1] =
                        (dp[r1][c1] + dp[i][j]) % MOD;
                }

                // Try moving down
                auto [r2, c2] = move(i, j, 1);

                if (r2 != -1) {
                    dp[r2][c2] =
                        (dp[r2][c2] + dp[i][j]) % MOD;
                }
            }
        }

        return dp[m - 1][n - 1];
    }
};
