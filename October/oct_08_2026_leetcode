class Solution {
public:
    string removeOuterParentheses(string s) {
        string ans;
        int depth = 0;

        for (char c : s) {
            if (c == '(') {
                // Skip the opening parenthesis of a primitive
                if (depth > 0)
                    ans += c;

                depth++;
            }
            else {
                depth--;

                // Skip the closing parenthesis of a primitive
                if (depth > 0)
                    ans += c;
            }
        }

        return ans;
    }
};
