class Solution {
public:
    bool isItPossible(string &s1, string &s2) {
        int n = s1.size();

        // Length cannot change
        if (s2.size() != n)
            return false;

        int i = 0, j = 0;

        while (i < n || j < n) {

            // Skip empty positions
            while (i < n && s1[i] == '#')
                i++;

            while (j < n && s2[j] == '#')
                j++;

            // Both reached the end
            if (i == n && j == n)
                return true;

            // One reached the end before the other
            if (i == n || j == n)
                return false;

            // A and B cannot cross
            if (s1[i] != s2[j])
                return false;

            // A can only move left
            if (s1[i] == 'A' && j > i)
                return false;

            // B can only move right
            if (s1[i] == 'B' && j < i)
                return false;

            i++;
            j++;
        }

        return true;
    }
};
