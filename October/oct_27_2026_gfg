class Solution {
public:
    int getMaxWeight(string &s) {

        int n = s.size();

        // dp[i] = maximum weight using first i characters
        vector<int> dp(n + 1, 0);

        // One character alone contributes 1
        dp[1] = 1;

        for (int i = 2; i <= n; i++) {

            // Leave the last character unpaired
            dp[i] = dp[i - 1] + 1;

            // Pair the last two characters
            int pairWeight;

            if (s[i - 2] != s[i - 1]) {
                // Already alternating
                pairWeight = 4;
            } else {
                // Need one toggle
                pairWeight = 4 - 1;
            }

            dp[i] = max(dp[i], dp[i - 2] + pairWeight);
        }

        return dp[n];
    }
};
