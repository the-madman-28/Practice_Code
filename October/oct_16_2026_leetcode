class Solution {
public:
    static const long long MOD = 1000000007LL;

    struct Node {
        long long sum = 0;      // sum of distinct counts
        long long sumSq = 0;    // sum of squares of distinct counts
        long long lazy = 0;
    };

    vector<Node> seg;

    void apply(int node, int l, int r, long long val) {
        long long len = r - l + 1;

        // IMPORTANT: save old sum before modifying it
        long long oldSum = seg[node].sum;

        // (x + val)^2 = x^2 + 2*val*x + val^2
        seg[node].sumSq =
            (seg[node].sumSq
            + 2LL * val % MOD * oldSum
            + val * val % MOD * len) % MOD;

        seg[node].sum =
            (oldSum + val * len) % MOD;

        seg[node].lazy =
            (seg[node].lazy + val) % MOD;
    }

    void push(int node, int l, int r) {
        if (seg[node].lazy == 0 || l == r)
            return;

        int mid = (l + r) / 2;

        apply(node * 2, l, mid, seg[node].lazy);
        apply(node * 2 + 1, mid + 1, r, seg[node].lazy);

        seg[node].lazy = 0;
    }

    void update(int node, int l, int r,
                int ql, int qr, long long val) {

        if (ql <= l && r <= qr) {
            apply(node, l, r, val);
            return;
        }

        push(node, l, r);

        int mid = (l + r) / 2;

        if (ql <= mid)
            update(node * 2, l, mid, ql, qr, val);

        if (qr > mid)
            update(node * 2 + 1, mid + 1, r, ql, qr, val);

        seg[node].sum =
            (seg[node * 2].sum +
             seg[node * 2 + 1].sum) % MOD;

        seg[node].sumSq =
            (seg[node * 2].sumSq +
             seg[node * 2 + 1].sumSq) % MOD;
    }

    int sumCounts(vector<int>& nums) {
        int n = nums.size();

        seg.assign(4 * n + 5, Node());

        vector<int> last(100001, -1);

        long long ans = 0;

        for (int r = 0; r < n; r++) {

            int x = nums[r];

            // Previous occurrence of nums[r]
            int p = last[x];

            /*
                For every starting index l:

                l <= p:
                    nums[r] was already present.

                l > p:
                    nums[r] is appearing for the first time.

                Therefore increase distinct count for:
                    [p + 1, r]
            */
            update(1, 0, n - 1, p + 1, r, 1);

            // Sum of squares of distinct counts
            // for all subarrays ending at r.
            ans = (ans + seg[1].sumSq) % MOD;

            last[x] = r;
        }

        return (int)ans;
    }
};
