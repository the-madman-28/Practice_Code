
class Solution {
  public:
    int countAlwaysFound(vector<int>& arr) {
        int n = arr.size();

        vector<int> suffixMin(n);
        suffixMin[n - 1] = arr[n - 1];

        // Build suffix minimums
        for (int i = n - 2; i >= 0; i--) {
            suffixMin[i] = min(arr[i], suffixMin[i + 1]);
        }

        int prefixMax = INT_MIN;
        int count = 0;

        for (int i = 0; i < n; i++) {
            int rightMin = (i == n - 1)
                               ? INT_MAX
                               : suffixMin[i + 1];

            if (arr[i] > prefixMax && arr[i] < rightMin) {
                count++;
            }

            prefixMax = max(prefixMax, arr[i]);
        }

        return count;
    }
};
