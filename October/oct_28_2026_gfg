class Solution {
public:
    char nthCharacter(int n) {
        long long len = 1;       // digits per number
        long long count = 9;     // numbers in current group
        long long start = 1;     // first number in current group

        // Find the digit-length group containing n
        while (n > len * count) {
            n -= len * count;
            len++;
            count *= 10;
            start *= 10;
        }

        // n is now 1-based within this group

        // Find which number contains the nth character
        long long number = start + (n - 1) / len;

        // Find which digit of that number
        int digitIndex = (n - 1) % len;

        string s = to_string(number);
        return s[digitIndex];
    }
};
