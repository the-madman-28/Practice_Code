class Solution {
public:
    vector<vector<int>> socialNetwork(vector<int>& arr) {
        int n = arr.size() + 1;

        vector<int> fr(n + 1);

        for (int i = 2; i <= n; i++) {
            fr[i] = arr[i - 2];
        }

        vector<vector<int>> ans;

        for (int i = 2; i <= n; i++) {
            vector<int> dist(n + 1, -1);

            int current = i;
            int d = 0;

            while (current != 1) {
                current = fr[current];
                d++;
                dist[current] = d;
            }

            // j must be in increasing order
            for (int j = 1; j < i; j++) {
                if (dist[j] != -1) {
                    ans.push_back({i, j, dist[j]});
                }
            }
        }

        return ans;
    }
};
