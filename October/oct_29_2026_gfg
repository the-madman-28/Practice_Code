class Solution {
public:
    int minComputation(vector<int> &files) {
        priority_queue<int, vector<int>, greater<int>> pq;

        for (int x : files)
            pq.push(x);

        int cost = 0;

        while (pq.size() > 1) {
            int a = pq.top();
            pq.pop();

            int b = pq.top();
            pq.pop();

            int merged = a + b;
            cost += merged;

            pq.push(merged);
        }

        return cost;
    }
};
