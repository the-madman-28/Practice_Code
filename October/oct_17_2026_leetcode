class Solution {
public:
    int digitSum(int x) {
        int sum = 0;

        while (x > 0) {
            sum += x % 10;
            x /= 10;
        }

        return sum;
    }

    int minSwaps(vector<int>& nums) {
        int n = nums.size();

        // Create target sorted array
        vector<int> target = nums;

        sort(target.begin(), target.end(), [&](int a, int b) {
            int sumA = digitSum(a);
            int sumB = digitSum(b);

            if (sumA != sumB)
                return sumA < sumB;

            return a < b;
        });

        // value -> current index
        unordered_map<int, int> pos;

        for (int i = 0; i < n; i++) {
            pos[nums[i]] = i;
        }

        int swaps = 0;

        // Find cycles
        for (int i = 0; i < n; i++) {

            // Already in correct position
            if (nums[i] == target[i])
                continue;

            int j = pos[target[i]];

            // Put target[i] at position i
            swap(nums[i], nums[j]);

            // Update positions after swap
            pos[nums[j]] = j;
            pos[nums[i]] = i;

            swaps++;
        }

        return swaps;
    }
};
