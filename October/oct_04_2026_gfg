class Solution {
public:
    int findPerimeter(vector<vector<int>> &mat) {
        int n = mat.size();
        int m = mat[0].size();

        int perimeter = 0;

        int dx[] = {-1, 1, 0, 0};
        int dy[] = {0, 0, -1, 1};

        for (int i = 0; i < n; i++) {
            for (int j = 0; j < m; j++) {

                if (mat[i][j] == 0)
                    continue;

                // Initially, every 1-cell has 4 sides
                perimeter += 4;

                // Subtract 2 for every adjacent 1-cell.
                // Only check top and left to avoid double counting.
                if (i > 0 && mat[i - 1][j] == 1)
                    perimeter -= 2;

                if (j > 0 && mat[i][j - 1] == 1)
                    perimeter -= 2;
            }
        }

        return perimeter;
    }
};
