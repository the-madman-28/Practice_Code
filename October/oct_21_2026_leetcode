class Solution {
public:
    int minOperations(string s) {
        int n = s.size();

        // Already sorted
        if (is_sorted(s.begin(), s.end()))
            return 0;

        // No useful proper substring exists
        if (n == 2)
            return -1;

        char mn = *min_element(s.begin(), s.end());
        char mx = *max_element(s.begin(), s.end());

        // Can be sorted in one operation
        if (s[0] == mn || s[n - 1] == mx)
            return 1;

        // Special case requiring three operations:
        // unique maximum at the beginning and
        // unique minimum at the end
        if (s[0] == mx && s[n - 1] == mn &&
            count(s.begin(), s.end(), mx) == 1 &&
            count(s.begin(), s.end(), mn) == 1) {
            return 3;
        }

        return 2;
    }
};
