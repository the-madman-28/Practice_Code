class Solution {
public:
    int maxPackages(vector<int>& arr, int totalTime) {
        int n = arr.size();

        if (n == 0 || totalTime == 0)
            return 0;

        totalTime = min(totalTime, n);

        long long sum = 0;
        long long ans = 0;

        for (int i = 0; i < n; i++) {
            sum += arr[i];

            // Keep exactly totalTime locations
            if (i >= totalTime)
                sum -= arr[i - totalTime];

            ans = max(ans, sum);
        }

        return (int)ans;
    }
};
