class Solution {
public:
    vector<int> update(int n, vector<int>& updates) {
        vector<int> freq(n + 1, 0);
        vector<int> arr(n, 0);

        // Count updates at each starting index
        for (int j : updates) {
            freq[j]++;
        }

        // Prefix sum
        int count = 0;

        for (int i = 1; i <= n; i++) {
            count += freq[i];
            arr[i - 1] = count;
        }

        return arr;
    }
};
