class Solution {
    vector<string> ans;

    void generate(string &cur, int open, int close, int n) {
        // Complete valid string
        if (cur.size() == 2 * n) {
            ans.push_back(cur);
            return;
        }

        // Add opening bracket
        if (open < n) {
            cur.push_back('(');
            generate(cur, open + 1, close, n);
            cur.pop_back();
        }

        // Add closing bracket only when valid
        if (close < open) {
            cur.push_back(')');
            generate(cur, open, close + 1, n);
            cur.pop_back();
        }
    }

public:
    vector<string> generateParenthesis(int n) {
        ans.clear();

        string cur;
        generate(cur, 0, 0, n);

        return ans;
    }
};
