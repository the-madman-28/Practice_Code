class Solution {
public:
    vector<int> maximumWeight(int n, vector<vector<int>> edges,
                              vector<int>& queries) {

        // Sort edges by weight
        sort(edges.begin(), edges.end(),
             [](const vector<int>& a, const vector<int>& b) {
                 return a[2] < b[2];
             });

        // Store queries along with their original indices
        vector<pair<int, int>> q;
        for (int i = 0; i < queries.size(); i++) {
            q.push_back({queries[i], i});
        }

        sort(q.begin(), q.end());

        // DSU
        vector<int> parent(n + 1);
        vector<long long> sz(n + 1, 1);

        iota(parent.begin(), parent.end(), 0);

        function<int(int)> find = [&](int x) {
            if (parent[x] == x)
                return x;
            return parent[x] = find(parent[x]);
        };

        auto unite = [&](int a, int b) {
            a = find(a);
            b = find(b);

            if (a == b)
                return 0LL;

            if (sz[a] < sz[b])
                swap(a, b);

            // Every node in a can now pair with
            // every node in b.
            long long newPaths = sz[a] * sz[b];

            parent[b] = a;
            sz[a] += sz[b];

            return newPaths;
        };

        vector<int> ans(queries.size());
        long long paths = 0;

        int j = 0;

        for (auto &[limit, index] : q) {

            // Add every edge whose weight <= query
            while (j < edges.size() && edges[j][2] <= limit) {
                paths += unite(edges[j][0], edges[j][1]);
                j++;
            }

            ans[index] = (int)paths;
        }

        return ans;
    }
};
