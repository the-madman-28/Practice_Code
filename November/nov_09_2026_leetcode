class Solution {
public:
    vector<int> busiestServers(int k, vector<int>& arrival, vector<int>& load) {
        // Available server IDs
        set<int> available;

        for (int i = 0; i < k; i++) {
            available.insert(i);
        }

        // {finish time, server ID}
        priority_queue<
            pair<long long, int>,
            vector<pair<long long, int>>,
            greater<pair<long long, int>>
        > busy;

        vector<int> count(k, 0);

        for (int i = 0; i < arrival.size(); i++) {

            // Release servers whose tasks are completed
            while (!busy.empty() && busy.top().first <= arrival[i]) {
                int id = busy.top().second;
                busy.pop();

                available.insert(id);
            }

            // All servers are busy
            if (available.empty()) {
                continue;
            }

            int preferred = i % k;

            // Find the first available server >= preferred
            auto it = available.lower_bound(preferred);

            // Wrap around if no such server exists
            if (it == available.end()) {
                it = available.begin();
            }

            int server = *it;

            // Assign the request
            available.erase(it);

            count[server]++;

            // Mark server as busy
            busy.push({
                1LL * arrival[i] + load[i],
                server
            });
        }

        // Find maximum number of handled requests
        int mx = *max_element(count.begin(), count.end());

        vector<int> ans;

        for (int i = 0; i < k; i++) {
            if (count[i] == mx) {
                ans.push_back(i);
            }
        }

        return ans;
    }
};
