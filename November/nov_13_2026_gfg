class Solution {
public:
    vector<int> findCommon(Node* r1, Node* r2) {
        vector<int> ans;

        stack<Node*> s1, s2;

        while (r1 || r2 || !s1.empty() || !s2.empty()) {

            // Inorder traversal of first BST
            while (r1) {
                s1.push(r1);
                r1 = r1->left;
            }

            // Inorder traversal of second BST
            while (r2) {
                s2.push(r2);
                r2 = r2->left;
            }

            if (s1.empty() || s2.empty())
                break;

            Node* a = s1.top();
            Node* b = s2.top();

            if (a->data == b->data) {
                ans.push_back(a->data);

                s1.pop();
                s2.pop();

                r1 = a->right;
                r2 = b->right;
            }
            else if (a->data < b->data) {
                s1.pop();
                r1 = a->right;
            }
            else {
                s2.pop();
                r2 = b->right;
            }
        }

        return ans;
    }
};
