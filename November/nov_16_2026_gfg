
class Solution {
  public:
    int findKthSmall(vector<int>& arr, int k) {
        int low = 1;
        int high = k + arr.size();

        while (low < high) {
            int mid = low + (high - low) / 2;

            int count = 0;

            for (int x : arr) {
                if (x <= mid)
                    count++;
            }

            int remaining = mid - count;

            if (remaining < k)
                low = mid + 1;
            else
                high = mid;
        }

        return low;
    }
};
