class Solution {
  public:
    int minFlips(string &s) {
        int flip0 = 0, flip1 = 0;

        for (int i = 0; i < s.length(); i++) {
            // Pattern 1: 010101...
            if (s[i] != (i % 2 == 0 ? '0' : '1'))
                flip0++;

            // Pattern 2: 101010...
            if (s[i] != (i % 2 == 0 ? '1' : '0'))
                flip1++;
        }

        return min(flip0, flip1);
    }
};
