class Solution {
public:
    vector<int> findSubtreeSizes(vector<int>& parent, string s) {
        int n = parent.size();

        vector<vector<int>> tree(n), finalTree(n);
        vector<int> newParent = parent;
        vector<int> last(26, -1);
        vector<int> ans(n, 0);

        // Build original tree
        for (int i = 1; i < n; i++) {
            tree[parent[i]].push_back(i);
        }

        // DFS on original tree to find nearest matching ancestor
        function<void(int)> dfs1 = [&](int node) {
            int c = s[node] - 'a';
            int prev = last[c];

            if (node != 0 && last[c] != -1)
                newParent[node] = last[c];

            last[c] = node;

            for (int child : tree[node]) {
                dfs1(child);
            }

            // Restore previous ancestor state
            last[c] = prev;
        };

        dfs1(0);

        // Build final tree
        for (int i = 1; i < n; i++) {
            finalTree[newParent[i]].push_back(i);
        }

        // DFS to calculate subtree sizes
        function<int(int)> dfs2 = [&](int node) {
            int size = 1;

            for (int child : finalTree[node]) {
                size += dfs2(child);
            }

            ans[node] = size;
            return size;
        };

        dfs2(0);

        return ans;
    }
};
