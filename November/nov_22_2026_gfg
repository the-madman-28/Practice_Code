class Solution {
  public:
    int longestSubarrayDivK(vector<int>& arr, int k) {
        unordered_map<int, int> firstIndex;
        firstIndex[0] = -1;

        int prefixSum = 0;
        int maxLen = 0;

        for (int i = 0; i < arr.size(); i++) {
            prefixSum += arr[i];

            int rem = ((prefixSum % k) + k) % k;

            if (firstIndex.find(rem) != firstIndex.end()) {
                maxLen = max(maxLen, i - firstIndex[rem]);
            }
            else {
                firstIndex[rem] = i;
            }
        }

        return maxLen;
    }
};
