
class Solution {
  public:
    int countBT(int h) {
        const long long MOD = 1000000007;

        if (h == 0 || h == 1)
            return 1;

        long long a = 1; // dp[0]
        long long b = 1; // dp[1]

        for (int i = 2; i <= h; i++) {
            long long c = (b * b) % MOD;

            c = (c + 2LL * b % MOD * a % MOD) % MOD;

            a = b;
            b = c;
        }

        return b;
    }
};
