class Solution {
  public:
    vector<int> countVowels(string &s, vector<vector<int>> &queries) {
        int n = s.size();
        vector<int> prefix(n + 1, 0);

        // Build prefix sum array
        for (int i = 0; i < n; i++) {
            char c = s[i];
            int isVowel = (c == 'a' || c == 'e' || c == 'i' || 
                           c == 'o' || c == 'u');

            prefix[i + 1] = prefix[i] + isVowel;
        }

        vector<int> ans;

        // Answer each query
        for (auto &q : queries) {
            int l = q[0];
            int r = q[1];

            ans.push_back(prefix[r + 1] - prefix[l]);
        }

        return ans;
    }
};
