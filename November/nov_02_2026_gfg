class Solution {
public:
    int largestSumCycle(vector<int>& edge) {
        int n = edge.size();
        vector<int> state(n, 0);
        int ans = -1;

        for (int i = 0; i < n; i++) {
            if (state[i] != 0)
                continue;

            int cur = i;

            // Nodes in the current traversal
            while (cur != -1 && state[cur] == 0) {
                state[cur] = 1;
                cur = edge[cur];
            }

            // Found a cycle
            if (cur != -1 && state[cur] == 1) {
                int sum = 0;
                int node = cur;

                do {
                    sum += node;
                    node = edge[node];
                } while (node != cur);

                ans = max(ans, sum);
            }

            // Mark the current path as completely processed
            cur = i;
            while (cur != -1 && state[cur] == 1) {
                state[cur] = 2;
                cur = edge[cur];
            }
        }

        return ans;
    }
};
