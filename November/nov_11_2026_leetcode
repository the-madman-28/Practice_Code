class Solution {
public:
    long long minimumCost(int cost1, int cost2, int costBoth,
                          int need1, int need2) {

        long long ans = 1LL * need1 * cost1 +
                        1LL * need2 * cost2;

        // Buy type 3 items for the smaller requirement
        long long common = min(need1, need2);

        long long option1 = common * costBoth +
            1LL * (need1 - common) * cost1 +
            1LL * (need2 - common) * cost2;

        // Buy type 3 items for the larger requirement
        long long option2 = 1LL * max(need1, need2) * costBoth;

        return min({ans, option1, option2});
    }
};
