
class Solution {
public:
    bool findPattern(string& s) {
        int n = s.size();
        int i = 0;

        while (i < n) {
            // Count consecutive x's
            if (s[i] != 'x')
                return false;

            int xCount = 0;
            while (i < n && s[i] == 'x') {
                xCount++;
                i++;
            }

            // Count consecutive y's
            int yCount = 0;
            while (i < n && s[i] == 'y') {
                yCount++;
                i++;
            }

            // Both counts must be equal
            if (xCount == 0 || xCount != yCount)
                return false;
        }

        return true;
    }
};
