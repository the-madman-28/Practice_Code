class Solution {
public:
    int getCount(string &s, int k) {
        vector<int> freq(26, 0);

        // Count groups for each character
        for (int i = 0; i < s.size(); i++) {
            if (i == 0 || s[i] != s[i - 1]) {
                freq[s[i] - 'a']++;
            }
        }

        // Count characters appearing in exactly k groups
        int ans = 0;

        for (int i = 0; i < 26; i++) {
            if (freq[i] == k) {
                ans++;
            }
        }

        return ans;
    }
};
