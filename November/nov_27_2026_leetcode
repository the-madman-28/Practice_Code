class Solution {
public:
    int maximumSaleItems(vector<vector<int>>& items, int budget) {
        int n = items.size();
        vector<int> dp(budget + 1, 0);

        // Calculate free-copy reward for each item type
        vector<int> bonus(n, 0);

        for (int i = 0; i < n; i++) {
            for (int j = 0; j < n; j++) {
                if (i != j && items[j][0] % items[i][0] == 0) {
                    bonus[i]++;
                }
            }
        }

        // Process each item type
        for (int i = 0; i < n; i++) {
            int price = items[i][1];
            int reward = bonus[i] + 1; // First purchased copy + freebies

            // 0/1 knapsack: buy the first copy of this type
            for (int b = budget; b >= price; b--) {
                dp[b] = max(dp[b], dp[b - price] + reward);
            }

            // Unbounded knapsack: additional purchased copies
            for (int b = price; b <= budget; b++) {
                dp[b] = max(dp[b], dp[b - price] + 1);
            }
        }

        return dp[budget];
    }
};
