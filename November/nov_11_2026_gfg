
class Solution {
public:
    bool checkWithinK(vector<int>& arr, int k) {
        unordered_map<int, int> lastIndex;

        for (int i = 0; i < arr.size(); i++) {

            if (lastIndex.find(arr[i]) != lastIndex.end()) {
                if (i - lastIndex[arr[i]] <= k) {
                    return true;
                }
            }

            lastIndex[arr[i]] = i;
        }

        return false;
    }
};
