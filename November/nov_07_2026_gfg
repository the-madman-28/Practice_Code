class Solution {
public:
    vector<string> generateUsernames(vector<string> arr) {
        unordered_set<string> reserved;
        unordered_set<string> assigned;
        unordered_map<string, int> nextSuffix;

        // Initially reserve all original usernames
        for (string &s : arr) {
            reserved.insert(s);
        }

        vector<string> ans;

        for (string &s : arr) {
            // First occurrence gets the original username
            if (!assigned.count(s)) {
                assigned.insert(s);
                ans.push_back(s);
                continue;
            }

            int &suffix = nextSuffix[s];
            if (suffix == 0) suffix = 1;

            string candidate;

            while (true) {
                candidate = s + to_string(suffix);
                suffix++;

                if (!reserved.count(candidate)) {
                    break;
                }
            }

            reserved.insert(candidate);
            assigned.insert(candidate);
            ans.push_back(candidate);
        }

        return ans;
    }
};
