class Solution {
public:
    int findMinCost(string &s1, string &s2, int costS1, int costS2) {
        int n = s1.size();
        int m = s2.size();

        // LCS using O(m) space
        vector<int> dp(m + 1, 0);

        for (int i = 1; i <= n; i++) {
            int prev = 0;

            for (int j = 1; j <= m; j++) {
                int temp = dp[j];

                if (s1[i - 1] == s2[j - 1]) {
                    dp[j] = prev + 1;
                } else {
                    dp[j] = max(dp[j], dp[j - 1]);
                }

                prev = temp;
            }
        }

        int lcs = dp[m];

        long long cost =
            1LL * (n - lcs) * costS1 +
            1LL * (m - lcs) * costS2;

        return (int)cost;
    }
};
