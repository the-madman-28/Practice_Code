/* Structure of binary tree Node
class Node {
    public:
    int data;
    Node *left, *right;
    Node(int x) {
        data = x;
        left = right = nullptr;
    }
};
*/

class Solution {
public:
    bool areAnagrams(Node* root1, Node* root2) {
        if (!root1 || !root2)
            return root1 == root2;

        queue<Node*> q1, q2;
        q1.push(root1);
        q2.push(root2);

        while (!q1.empty() && !q2.empty()) {
            int n1 = q1.size();
            int n2 = q2.size();

            // Corresponding levels must have the same number of nodes
            if (n1 != n2)
                return false;

            vector<int> level1, level2;

            // Process current level of tree 1
            for (int i = 0; i < n1; i++) {
                Node* node = q1.front();
                q1.pop();

                level1.push_back(node->data);

                if (node->left)
                    q1.push(node->left);

                if (node->right)
                    q1.push(node->right);
            }

            // Process current level of tree 2
            for (int i = 0; i < n2; i++) {
                Node* node = q2.front();
                q2.pop();

                level2.push_back(node->data);

                if (node->left)
                    q2.push(node->left);

                if (node->right)
                    q2.push(node->right);
            }

            // Check whether the two levels are anagrams
            sort(level1.begin(), level1.end());
            sort(level2.begin(), level2.end());

            if (level1 != level2)
                return false;
        }

        // Both trees should finish at the same time
        return q1.empty() && q2.empty();
    }
};
