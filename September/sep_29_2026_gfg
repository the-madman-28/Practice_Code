class Solution {
public:
    int minStepToReachTarget(vector<int>& knightPos,
                             vector<int>& targetPos,
                             int n) {
        
        int sx = knightPos[0] - 1;
        int sy = knightPos[1] - 1;
        int tx = targetPos[0] - 1;
        int ty = targetPos[1] - 1;

        if (sx == tx && sy == ty)
            return 0;

        int dx[] = {2, 2, -2, -2, 1, 1, -1, -1};
        int dy[] = {1, -1, 1, -1, 2, -2, 2, -2};

        vector<vector<bool>> visited(n, vector<bool>(n, false));

        queue<pair<pair<int, int>, int>> q;

        q.push({{sx, sy}, 0});
        visited[sx][sy] = true;

        while (!q.empty()) {
            auto [pos, moves] = q.front();
            q.pop();

            int x = pos.first;
            int y = pos.second;

            for (int i = 0; i < 8; i++) {
                int nx = x + dx[i];
                int ny = y + dy[i];

                if (nx >= 0 && nx < n &&
                    ny >= 0 && ny < n &&
                    !visited[nx][ny]) {

                    if (nx == tx && ny == ty)
                        return moves + 1;

                    visited[nx][ny] = true;
                    q.push({{nx, ny}, moves + 1});
                }
            }
        }

        return -1;
    }
};
