class Solution {
public:
    int distinctSubseqII(string s) {
        const int MOD = 1e9 + 7;

        long long dp = 1; // includes empty subsequence
        vector<long long> last(26, 0);

        for (char ch : s) {
            int idx = ch - 'a';

            long long newDp = (2 * dp % MOD - last[idx] + MOD) % MOD;

            // Store the number of subsequences before processing
            // this occurrence of the character
            last[idx] = dp;

            dp = newDp;
        }

        // Exclude empty subsequence
        return (dp - 1 + MOD) % MOD;
    }
};
