class Solution {
  public:
    int solve(int n, string s) {
        vector<int> state(26, 0);
        // 0 = not seen
        // 1 = currently using a computer
        // 2 = rejected

        int occupied = 0;
        int rejected = 0;

        for (char ch : s) {
            int id = ch - 'A';

            if (state[id] == 0) {
                // Customer arrives
                if (occupied < n) {
                    state[id] = 1;
                    occupied++;
                } else {
                    state[id] = 2;
                    rejected++;
                }
            } 
            else {
                // Customer departs
                if (state[id] == 1) {
                    occupied--;
                }
                // If state[id] == 2, customer was rejected,
                // so no computer needs to be released.

                // Mark as processed (optional)
                state[id] = 3;
            }
        }

        return rejected;
    }
};
