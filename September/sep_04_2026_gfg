class Solution {
  public:
    int maxFruits(vector<int>& arr, int m) {
        int n = arr.size();

        // If bird can visit all trees
        if (m >= n) {
            long long total = 0;
            for (int x : arr) total += x;
            return total;
        }

        long long windowSum = 0;

        // First window
        for (int i = 0; i < m; i++) {
            windowSum += arr[i];
        }

        long long maxSum = windowSum;

        // Check remaining circular windows
        for (int start = 1; start < n; start++) {
            int removeIdx = start - 1;
            int addIdx = (start + m - 1) % n;

            windowSum -= arr[removeIdx];
            windowSum += arr[addIdx];

            maxSum = max(maxSum, windowSum);
        }

        return maxSum;
    }
};
