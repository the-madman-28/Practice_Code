class Solution {
public:
    int minimumCost(int x, int s, int m, int l,
                    int cs, int cm, int cl) {
        
        int maxArea = max({s, m, l});
        const int INF = 1e9;

        // We may need to go beyond x because pizzas
        // cannot be partially purchased.
        int limit = x + maxArea;

        vector<int> dp(limit + 1, INF);
        dp[0] = 0;

        for (int area = 0; area <= limit; area++) {
            if (dp[area] == INF)
                continue;

            if (area + s <= limit)
                dp[area + s] = min(dp[area + s],
                                    dp[area] + cs);

            if (area + m <= limit)
                dp[area + m] = min(dp[area + m],
                                    dp[area] + cm);

            if (area + l <= limit)
                dp[area + l] = min(dp[area + l],
                                    dp[area] + cl);
        }

        int ans = INF;

        for (int area = x; area <= limit; area++) {
            ans = min(ans, dp[area]);
        }

        return ans;
    }
};
