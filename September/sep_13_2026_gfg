class Solution {
public:

    pair<int, int> bfs(int src, vector<vector<int>>& adj) {
        int n = adj.size();

        vector<int> dist(n, -1);
        queue<int> q;

        dist[src] = 0;
        q.push(src);

        int farthest = src;

        while (!q.empty()) {
            int u = q.front();
            q.pop();

            if (dist[u] > dist[farthest])
                farthest = u;

            for (int v : adj[u]) {
                --v;  // adjacency contains 1-based house numbers

                if (dist[v] == -1) {
                    dist[v] = dist[u] + 1;
                    q.push(v);
                }
            }
        }

        return {farthest, dist[farthest]};
    }

    int partyHouse(vector<vector<int>>& adj) {
        // First BFS: find one endpoint of diameter
        auto p1 = bfs(0, adj);
        int A = p1.first;

        // Second BFS: find diameter length
        auto p2 = bfs(A, adj);
        int diameter = p2.second;

        // Minimum possible maximum distance
        return (diameter + 1) / 2;
    }
};
