class Solution {
  public:
    int maxDiffSum(vector<int>& arr) {
        int n = arr.size();

        if (n == 1) return 0;

        long long dpOriginal = 0; // current element kept as arr[0]
        long long dpOne = 0;      // current element changed to 1

        for (int i = 1; i < n; i++) {
            long long newOriginal = max(
                dpOriginal + abs(arr[i] - arr[i - 1]),
                dpOne + abs(arr[i] - 1)
            );

            long long newOne = max(
                dpOriginal + abs(1 - arr[i - 1]),
                dpOne + abs(1 - 1)
            );

            dpOriginal = newOriginal;
            dpOne = newOne;
        }

        return max(dpOriginal, dpOne);
    }
};
