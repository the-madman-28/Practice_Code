class Solution {
public:
    int minMoves(vector<string>& classroom, int energy) {
        int m = classroom.size();
        int n = classroom[0].size();

        int sx = -1, sy = -1;
        vector<vector<int>> litterId(m, vector<int>(n, -1));
        int litterCount = 0;

        // Find start position and assign IDs to litter
        for (int i = 0; i < m; i++) {
            for (int j = 0; j < n; j++) {
                if (classroom[i][j] == 'S') {
                    sx = i;
                    sy = j;
                } 
                else if (classroom[i][j] == 'L') {
                    litterId[i][j] = litterCount++;
                }
            }
        }

        // No litter to collect
        if (litterCount == 0)
            return 0;

        int fullMask = (1 << litterCount) - 1;
        int cells = m * n;

        /*
            best[mask][position] = maximum remaining energy
            with which we have reached this state.
        */
        vector<vector<int>> best(
            1 << litterCount,
            vector<int>(cells, -1)
        );

        // {x, y, mask, remainingEnergy}
        queue<tuple<int, int, int, int>> q;

        int startPos = sx * n + sy;
        best[0][startPos] = energy;
        q.push({sx, sy, 0, energy});

        int moves = 0;

        int dx[] = {-1, 1, 0, 0};
        int dy[] = {0, 0, -1, 1};

        while (!q.empty()) {
            int sz = q.size();

            while (sz--) {
                auto [x, y, mask, currEnergy] = q.front();
                q.pop();

                if (mask == fullMask)
                    return moves;

                // Cannot make another move with 0 energy
                if (currEnergy == 0)
                    continue;

                for (int dir = 0; dir < 4; dir++) {
                    int nx = x + dx[dir];
                    int ny = y + dy[dir];

                    if (nx < 0 || nx >= m || ny < 0 || ny >= n)
                        continue;

                    if (classroom[nx][ny] == 'X')
                        continue;

                    int newEnergy = currEnergy - 1;
                    int newMask = mask;

                    // Collect litter
                    if (classroom[nx][ny] == 'L') {
                        newMask |= (1 << litterId[nx][ny]);
                    }

                    // Reset energy
                    if (classroom[nx][ny] == 'R') {
                        newEnergy = energy;
                    }

                    int pos = nx * n + ny;

                    // If we already reached this state with
                    // equal or greater energy, skip it
                    if (best[newMask][pos] >= newEnergy)
                        continue;

                    best[newMask][pos] = newEnergy;
                    q.push({nx, ny, newMask, newEnergy});
                }
            }

            moves++;
        }

        return -1;
    }
};
