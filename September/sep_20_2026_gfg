class Solution {
public:
    int largestSubsquare(vector<vector<char>> &mat) {
        int n = mat.size();

        vector<vector<int>> right(n, vector<int>(n, 0));
        vector<vector<int>> down(n, vector<int>(n, 0));

        // Precompute consecutive X's to the right and downward
        for (int i = n - 1; i >= 0; i--) {
            for (int j = n - 1; j >= 0; j--) {

                if (mat[i][j] == 'X') {
                    right[i][j] = 1;
                    down[i][j] = 1;

                    if (j + 1 < n)
                        right[i][j] += right[i][j + 1];

                    if (i + 1 < n)
                        down[i][j] += down[i + 1][j];
                }
            }
        }

        // Try the largest possible square first
        for (int size = n; size >= 1; size--) {

            for (int i = 0; i + size <= n; i++) {
                for (int j = 0; j + size <= n; j++) {

                    int bottom = i + size - 1;
                    int rightCol = j + size - 1;

                    // Check all four boundaries
                    if (right[i][j] >= size &&          // top
                        down[i][j] >= size &&           // left
                        right[bottom][j] >= size &&     // bottom
                        down[i][rightCol] >= size) {    // right

                        return size;
                    }
                }
            }
        }

        return 0;
    }
};
