class Solution {
public:
    int sameMod(vector<int> &arr) {
        int g = 0;

        for (int i = 1; i < arr.size(); i++) {
            g = __gcd(g, abs(arr[i] - arr[0]));
        }

        // All elements are equal
        if (g == 0)
            return -1;

        // Count divisors of g
        int ans = 0;

        for (int d = 1; d * d <= g; d++) {
            if (g % d == 0) {
                ans++;              // d

                if (d != g / d)
                    ans++;          // g/d
            }
        }

        return ans;
    }
};
