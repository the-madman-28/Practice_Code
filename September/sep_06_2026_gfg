class Solution {
  public:
    long long pairAndSum(vector<int> &arr) {
        long long ans = 0;

        // arr[i] <= 1e8, so bits 0 to 30 are sufficient
        for (int bit = 0; bit < 31; bit++) {
            long long cnt = 0;

            // Count numbers having this bit set
            for (int num : arr) {
                if (num & (1 << bit)) {
                    cnt++;
                }
            }

            // Number of pairs where both have this bit set
            long long pairs = cnt * (cnt - 1) / 2;

            ans += pairs * (1LL << bit);
        }

        return ans;
    }
};
