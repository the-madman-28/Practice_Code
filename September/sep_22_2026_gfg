class Solution {
public:
    string findLongestWord(string &s, vector<string> &d) {
        int n = s.size();

        // positions[c] = positions where character c occurs in s
        vector<vector<int>> positions(26);

        for (int i = 0; i < n; i++) {
            positions[s[i] - 'a'].push_back(i);
        }

        string ans = "";

        for (string &word : d) {
            int prev = -1;
            bool possible = true;

            for (char c : word) {
                auto &v = positions[c - 'a'];

                // Find first occurrence of c after prev
                auto it = upper_bound(v.begin(), v.end(), prev);

                if (it == v.end()) {
                    possible = false;
                    break;
                }

                prev = *it;
            }

            if (possible) {
                // Prefer longer word
                if (word.length() > ans.length()) {
                    ans = word;
                }
                // Same length -> lexicographically smaller
                else if (word.length() == ans.length() && word < ans) {
                    ans = word;
                }
            }
        }

        return ans;
    }
};
