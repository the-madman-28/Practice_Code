class Solution {
public:
    int ways(int x, int y) {
        const int MOD = 1000000007;

        int n = x + y;

        vector<vector<long long>> dp(n + 1,
                                    vector<long long>(x + 1, 0));

        // C(0, 0) = 1
        dp[0][0] = 1;

        for (int i = 1; i <= n; i++) {
            dp[i][0] = 1;

            for (int j = 1; j <= min(i, x); j++) {
                dp[i][j] = (dp[i - 1][j - 1] + dp[i - 1][j]) % MOD;
            }
        }

        return dp[n][x];
    }
};
