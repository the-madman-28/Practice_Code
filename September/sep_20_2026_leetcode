class Solution {
public:
    int reverseDegree(string s) {
        int ans = 0;

        for (int i = 0; i < s.length(); i++) {
            // 'a' -> 26, 'b' -> 25, ..., 'z' -> 1
            int reversePos = 'z' - s[i] + 1;

            // i + 1 because string position is 1-indexed
            ans += reversePos * (i + 1);
        }

        return ans;
    }
};
