/* Binary Tree Node Structure
class Node {
public:
    int data;
    Node *left;
    Node *right;

    Node(int val) {
        data = val;
        left = right = nullptr;
    }
}; 
*/

class Solution {
public:
    int absDiff(Node *root) {
        stack<Node*> st;
        Node* curr = root;

        int prev = -1;
        int ans = INT_MAX;

        while (curr || !st.empty()) {

            // Go to the smallest value
            while (curr) {
                st.push(curr);
                curr = curr->left;
            }

            curr = st.top();
            st.pop();

            // Compare with previous inorder value
            if (prev != -1) {
                ans = min(ans, curr->data - prev);
            }

            prev = curr->data;

            curr = curr->right;
        }

        return ans;
    }
};
