class Solution {
public:
    int stoneGameVIII(vector<int>& stones) {
        int n = stones.size();

        // prefix[i] = sum of first i stones
        vector<long long> prefix(n);

        prefix[0] = stones[0];

        for (int i = 1; i < n; i++) {
            prefix[i] = prefix[i - 1] + stones[i];
        }

        // Initially, Alice can take all n stones.
        long long ans = prefix[n - 1];

        // Consider taking first i stones, where i >= 2.
        // Work backwards.
        for (int i = n - 2; i >= 1; i--) {
            ans = max(ans, prefix[i] - ans);
        }

        return (int)ans;
    }
};
