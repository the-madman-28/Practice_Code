class Solution {
public:
    int n;
    vector<int> suffix;
    vector<vector<int>> dp;

    int solve(int i, int M) {
        // All piles have been taken.
        if (i >= n)
            return 0;

        // Already calculated.
        if (dp[i][M] != -1)
            return dp[i][M];

        // If we can take all remaining piles.
        if (2 * M >= n - i)
            return dp[i][M] = suffix[i];

        int total = suffix[i];
        int best = 0;

        // Try taking X piles.
        for (int X = 1; X <= 2 * M; X++) {
            int opponent = solve(i + X, max(M, X));

            // Current player gets everything remaining
            // except what the opponent can obtain.
            best = max(best, total - opponent);
        }

        return dp[i][M] = best;
    }

    int stoneGameII(vector<int>& piles) {
        n = piles.size();

        // suffix[i] = sum of piles[i ... n-1]
        suffix.assign(n + 1, 0);

        for (int i = n - 1; i >= 0; i--) {
            suffix[i] = suffix[i + 1] + piles[i];
        }

        /*
            M can never need to exceed n.
        */
        dp.assign(n, vector<int>(n + 1, -1));

        return solve(0, 1);
    }
};
