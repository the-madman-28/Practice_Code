class Solution {
public:

    vector<int> largestSquare(vector<vector<int>>& mat,
                               vector<vector<int>>& queries,
                               int k) {
        
        int n = mat.size();
        int m = mat[0].size();

        // 2D prefix sum
        vector<vector<int>> pref(n + 1, vector<int>(m + 1, 0));

        for (int i = 0; i < n; i++) {
            for (int j = 0; j < m; j++) {
                pref[i + 1][j + 1] =
                    mat[i][j]
                    + pref[i][j + 1]
                    + pref[i + 1][j]
                    - pref[i][j];
            }
        }

        // Returns number of ones in [r1..r2] x [c1..c2]
        auto getSum = [&](int r1, int c1, int r2, int c2) {
            return pref[r2 + 1][c2 + 1]
                 - pref[r1][c2 + 1]
                 - pref[r2 + 1][c1]
                 + pref[r1][c1];
        };

        vector<int> ans;

        for (auto &q : queries) {
            int i = q[0];
            int j = q[1];

            // Maximum possible radius before going outside matrix.
            int maxRadius = min({
                i,
                j,
                n - 1 - i,
                m - 1 - j
            });

            // Check whether radius r is valid.
            auto valid = [&](int r) {
                int r1 = i - r;
                int c1 = j - r;
                int r2 = i + r;
                int c2 = j + r;

                return getSum(r1, c1, r2, c2) <= k;
            };

            // Even the 1x1 square is invalid.
            if (!valid(0)) {
                ans.push_back(-1);
                continue;
            }

            // Binary search largest valid radius.
            int low = 0;
            int high = maxRadius;
            int best = 0;

            while (low <= high) {
                int mid = low + (high - low) / 2;

                if (valid(mid)) {
                    best = mid;
                    low = mid + 1;
                } else {
                    high = mid - 1;
                }
            }

            // radius r -> side length 2r + 1
            ans.push_back(2 * best + 1);
        }

        return ans;
    }
};
