class Solution {
public:
    vector<int> findWays(vector<vector<int>>& grid) {
        const int MOD = 1000000007;
        int n = grid.size();

        vector<vector<long long>> ways(
            n, vector<long long>(n, 0)
        );

        vector<vector<int>> best(
            n, vector<int>(n, -1)
        );

        // Starting cell.
        ways[0][0] = 1;
        best[0][0] = grid[0][0];

        for (int i = 0; i < n; i++) {
            for (int j = 0; j < n; j++) {

                if (i == 0 && j == 0)
                    continue;

                // From the cell above:
                // The above cell must allow moving DOWN.
                if (i > 0 && (grid[i - 1][j] == 2 ||
                              grid[i - 1][j] == 3)) {

                    ways[i][j] =
                        (ways[i][j] + ways[i - 1][j]) % MOD;

                    if (best[i - 1][j] != -1) {
                        best[i][j] = max(
                            best[i][j],
                            best[i - 1][j] + grid[i][j]
                        );
                    }
                }

                // From the cell on the left:
                // The left cell must allow moving RIGHT.
                if (j > 0 && (grid[i][j - 1] == 1 ||
                              grid[i][j - 1] == 3)) {

                    ways[i][j] =
                        (ways[i][j] + ways[i][j - 1]) % MOD;

                    if (best[i][j - 1] != -1) {
                        best[i][j] = max(
                            best[i][j],
                            best[i][j - 1] + grid[i][j]
                        );
                    }
                }
            }
        }

        // No valid path exists.
        if (ways[n - 1][n - 1] == 0)
            return {0, 0};

        return {
            (int)ways[n - 1][n - 1],
            best[n - 1][n - 1]
        };
    }
};
