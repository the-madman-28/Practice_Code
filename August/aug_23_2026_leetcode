class Solution {
public:
    bool sumGame(string num) {
        int n = num.size();
        int mid = n / 2;

        int leftQ = 0, rightQ = 0;
        int diff = 0;

        // First half
        for (int i = 0; i < mid; i++) {
            if (num[i] == '?')
                leftQ++;
            else
                diff += num[i] - '0';
        }

        // Second half
        for (int i = mid; i < n; i++) {
            if (num[i] == '?')
                rightQ++;
            else
                diff -= num[i] - '0';
        }

        // Alice wins if she can force the final sums to be different.
        if ((leftQ + rightQ) % 2 == 1)
            return true;

        return diff * 2 != 9 * (rightQ - leftQ);
    }
};
