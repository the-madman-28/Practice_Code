class Solution {
public:
    vector<int> validSequence(string word1, string word2) {
        int n = word1.size();
        int m = word2.size();

        // Positions of every character in word1.
        vector<vector<int>> pos(26);

        for (int i = 0; i < n; i++) {
            pos[word1[i] - 'a'].push_back(i);
        }

        /*
            exact[j]:
            Latest possible position of word2[j] such that
            word2[j..m-1] can be matched exactly.

            one[j]:
            Latest possible position of word2[j] such that
            word2[j..m-1] can be matched with at most one mismatch.

            -1 means impossible.
        */
        vector<int> exact(m, -1);
        vector<int> one(m, -1);

        // Find latest occurrence of a character strictly before 'limit'.
        auto prevOccurrence = [&](int c, int limit) -> int {
            const auto &v = pos[c];

            auto it = lower_bound(v.begin(), v.end(), limit);

            if (it == v.begin())
                return -1;

            --it;
            return *it;
        };

        // Base case: last character.
        {
            int c = word2[m - 1] - 'a';

            // Exact match.
            if (!pos[c].empty())
                exact[m - 1] = pos[c].back();

            // With one mismatch, any character can be used.
            one[m - 1] = n - 1;
        }

        // Build from right to left.
        for (int j = m - 2; j >= 0; j--) {
            int c = word2[j] - 'a';

            // -------------------------
            // Exact matching
            // -------------------------
            if (exact[j + 1] != -1) {
                exact[j] = prevOccurrence(c, exact[j + 1]);
            }

            // -------------------------
            // At most one mismatch
            // -------------------------

            // Case 1:
            // Current character matches exactly,
            // and suffix uses the one allowed mismatch.
            if (one[j + 1] != -1) {
                one[j] = prevOccurrence(c, one[j + 1]);
            }

            // Case 2:
            // Use the mismatch at the current character.
            // Then the remaining suffix must match exactly.
            if (exact[j + 1] != -1) {
                int mismatchPos = exact[j + 1] - 1;

                if (mismatchPos >= 0) {
                    one[j] = max(one[j], mismatchPos);
                }
            }
        }

        /*
            We now greedily construct the answer.

            usedMismatch = whether the one allowed mismatch
            has already been consumed.
        */

        vector<int> ans;
        ans.reserve(m);

        int prev = -1;
        bool usedMismatch = false;

        for (int j = 0; j < m; j++) {

            int start = prev + 1;

            // We need enough characters left.
            if (start >= n || n - start < m - j) {
                return {};
            }

            int target = word2[j] - 'a';

            // ------------------------------------------------
            // Candidate 1: earliest index having exact character
            // ------------------------------------------------
            int equalIndex = -1;

            {
                const auto &v = pos[target];

                auto it = lower_bound(v.begin(), v.end(), start);

                if (it != v.end())
                    equalIndex = *it;
            }

            // ------------------------------------------------
            // Candidate 2: earliest index with different character
            // ------------------------------------------------
            int differentIndex = -1;

            if (!usedMismatch) {
                differentIndex = start;

                if (differentIndex < n &&
                    word1[differentIndex] == word2[j]) {
                    differentIndex++;
                }

                if (differentIndex >= n)
                    differentIndex = -1;
            }

            /*
                Check whether choosing index i is feasible.
            */
            auto feasibleEqual = [&](int i) -> bool {
                if (i == -1)
                    return false;

                if (j == m - 1)
                    return true;

                if (usedMismatch) {
                    // Mismatch already used, so remaining
                    // characters must match exactly.
                    return exact[j + 1] > i;
                } else {
                    // We still have one mismatch available.
                    return one[j + 1] > i;
                }
            };

            auto feasibleDifferent = [&](int i) -> bool {
                if (i == -1 || usedMismatch)
                    return false;

                if (j == m - 1)
                    return true;

                // Current character consumes the mismatch,
                // so the remainder must be exact.
                return exact[j + 1] > i;
            };

            /*
                Since we want the lexicographically smallest
                index array, compare the candidate indices directly.
            */

            bool chooseEqual = feasibleEqual(equalIndex);
            bool chooseDifferent = feasibleDifferent(differentIndex);

            if (!chooseEqual && !chooseDifferent) {
                return {};
            }

            int chosen;

            if (chooseEqual && chooseDifferent) {
                if (equalIndex < differentIndex) {
                    chosen = equalIndex;
                } else {
                    chosen = differentIndex;
                    usedMismatch = true;
                }
            }
            else if (chooseEqual) {
                chosen = equalIndex;
            }
            else {
                chosen = differentIndex;
                usedMismatch = true;
            }

            ans.push_back(chosen);
            prev = chosen;
        }

        return ans;
    }
};
