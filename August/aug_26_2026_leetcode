class Solution {
public:
    string shortestBeautifulSubstring(string s, int k) {
        int n = s.size();

        int left = 0;
        int ones = 0;

        int bestLen = INT_MAX;
        string ans = "";

        for (int right = 0; right < n; right++) {
            if (s[right] == '1')
                ones++;

            // Shrink while we have more than k ones
            while (ones > k) {
                if (s[left] == '1')
                    ones--;
                left++;
            }

            // We have exactly k ones
            if (ones == k) {
                // Remove unnecessary leading zeros.
                int start = left;
                while (start <= right && s[start] == '0')
                    start++;

                int len = right - start + 1;

                string current = s.substr(start, len);

                if (len < bestLen ||
                    (len == bestLen && current < ans)) {
                    bestLen = len;
                    ans = current;
                }
            }
        }

        return ans;
    }
};
