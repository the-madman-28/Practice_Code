class Solution {
  public:
    vector<int> getMarks(vector<int> &l, vector<int> &r, vector<int> &rank) {
        int n = l.size();

        // prefix[i] = total number of valid marks till interval i
        vector<long long> prefix(n);

        prefix[0] = r[0] - l[0] + 1;

        for (int i = 1; i < n; i++) {
            prefix[i] = prefix[i - 1] + (long long)(r[i] - l[i] + 1);
        }

        vector<int> ans;

        for (int k : rank) {
            // Find the first interval whose cumulative size >= k
            int idx = lower_bound(prefix.begin(), prefix.end(), (long long)k)
                      - prefix.begin();

            long long previous = (idx == 0) ? 0 : prefix[idx - 1];

            // Position within current interval (0-indexed)
            long long offset = k - previous - 1;

            ans.push_back(l[idx] + offset);
        }

        return ans;
    }
};
