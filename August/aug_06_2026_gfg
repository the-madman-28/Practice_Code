class Solution {
public:
    int countMinOperations(vector<int>& arr) {

        int increments = 0;
        int maxBits = 0;

        for (int x : arr) {
            increments += __builtin_popcount(x);

            if (x)
                maxBits = max(maxBits, 32 - __builtin_clz(x));
        }

        return increments + max(0, maxBits - 1);
    }
};
